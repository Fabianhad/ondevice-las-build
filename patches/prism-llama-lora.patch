diff --git a/IOSLocalLLM/Services/LlamaCpp/GGUFContextSettings.swift b/IOSLocalLLM/Services/LlamaCpp/GGUFContextSettings.swift
new file mode 100644
index 0000000..e878610
--- /dev/null
+++ b/IOSLocalLLM/Services/LlamaCpp/GGUFContextSettings.swift
@@ -0,0 +1,169 @@
+import Foundation
+import Combine
+
+// Per-model context length and max output for imported GGUF models, plus a
+// rough memory estimate (weights + KV cache) to warn before a load that iOS
+// would likely kill.
+
+/// Shape of a GGUF read from its header (no weights are loaded).
+struct GGUFModelShape: Equatable, Sendable {
+    let fileBytes: Int64
+    /// Context length the model was trained for (0 = unknown).
+    let trainedContext: Int
+    /// KV-cache elements stored per token, over every layer that keeps one.
+    let kvElementsPerToken: Int
+
+    static func read(path: String) -> GGUFModelShape? {
+        guard let ctx = gguf_init_from_file(path, gguf_init_params(no_alloc: true, ctx: nil)) else {
+            return nil
+        }
+        defer { gguf_free(ctx) }
+
+        func int(_ key: String) -> Int? {
+            let id = gguf_find_key(ctx, key)
+            guard id >= 0 else { return nil }
+            switch gguf_get_kv_type(ctx, id) {
+            case GGUF_TYPE_UINT32: return Int(gguf_get_val_u32(ctx, id))
+            case GGUF_TYPE_INT32: return Int(gguf_get_val_i32(ctx, id))
+            case GGUF_TYPE_UINT64: return Int(clamping: gguf_get_val_u64(ctx, id))
+            case GGUF_TYPE_ARRAY:
+                // Per-layer values (e.g. head_count_kv): use the largest.
+                let type = gguf_get_arr_type(ctx, id)
+                guard type == GGUF_TYPE_UINT32 || type == GGUF_TYPE_INT32,
+                      let data = gguf_get_arr_data(ctx, id) else { return nil }
+                let values = UnsafeBufferPointer(
+                    start: data.assumingMemoryBound(to: Int32.self),
+                    count: gguf_get_arr_n(ctx, id)
+                )
+                return values.map { Int($0) }.max()
+            default: return nil
+            }
+        }
+
+        let archID = gguf_find_key(ctx, "general.architecture")
+        guard archID >= 0, let archName = gguf_get_val_str(ctx, archID) else { return nil }
+        let arch = String(cString: archName)
+        let layers = int("\(arch).block_count") ?? 0
+        let heads = int("\(arch).attention.head_count") ?? 0
+        let headsKV = int("\(arch).attention.head_count_kv") ?? heads
+        let headDim = heads > 0 ? (int("\(arch).embedding_length") ?? 0) / heads : 0
+        let keyLength = int("\(arch).attention.key_length") ?? headDim
+        let valueLength = int("\(arch).attention.value_length") ?? headDim
+        // Hybrid models (Qwen 3.5, Ternary Bonsai 2) keep a KV cache only on
+        // every Nth layer; the others hold a small fixed recurrent state.
+        let interval = max(1, int("\(arch).full_attention_interval") ?? 1)
+        let attentionLayers = layers / interval
+
+        let attributes = try? FileManager.default.attributesOfItem(atPath: path)
+        let fileBytes = (attributes?[.size] as? NSNumber)?.int64Value ?? 0
+        return GGUFModelShape(
+            fileBytes: fileBytes,
+            trainedContext: int("\(arch).context_length") ?? 0,
+            kvElementsPerToken: attentionLayers * headsKV * (keyLength + valueLength)
+        )
+    }
+}
+
+enum GGUFMemoryEstimate {
+    /// Recurrent state, compute buffers and runtime overhead (rough).
+    static let runtimeOverhead: Int64 = 450_000_000
+    /// Headroom kept free so iOS does not kill the app at the limit.
+    static let safetyMargin: Int64 = 600_000_000
+
+    /// KV cache bytes for `context` tokens; q8_0 stores 32 values in 34 bytes.
+    static func kvBytes(elementsPerToken: Int, context: Int, quantized: Bool = true) -> Int64 {
+        let bytesPerElement = quantized ? 34.0 / 32.0 : 2.0
+        return Int64(Double(elementsPerToken) * Double(context) * bytesPerElement)
+    }
+
+    /// Weights + KV cache + overhead for one loaded model.
+    static func totalBytes(_ shape: GGUFModelShape, context: Int) -> Int64 {
+        shape.fileBytes
+            + kvBytes(elementsPerToken: shape.kvElementsPerToken, context: context)
+            + runtimeOverhead
+    }
+
+    /// Memory a (re)load could use: what the process may still allocate
+    /// (os_proc_available_memory) plus what the currently loaded GGUF holds,
+    /// since a reload frees it first.
+    static var availableBytes: Int64 {
+        MemoryAdvisor.processAvailableMemory + GGUFContextSettingsStore.shared.residentBytes
+    }
+
+    static func likelyExceeds(_ shape: GGUFModelShape, context: Int) -> Bool {
+        let available = availableBytes
+        return available > 0 && totalBytes(shape, context: context) + safetyMargin > available
+    }
+}
+
+/// Saved context length / max output per imported GGUF model. Reads are safe
+/// from any thread (UserDefaults); writes happen from the UI.
+final class GGUFContextSettingsStore: ObservableObject {
+    static let shared = GGUFContextSettingsStore()
+
+    static let contextChoices = [4_096, 8_192, 16_384, 32_768, 65_536]
+    /// The app's thermal guard caps replies near 4096 on current iPhones.
+    static let outputChoices = [1_024, 2_048, 4_096]
+    static let defaultContext = 32_768
+    static let defaultOutput = 4_096
+
+    private static let contextKey = "ggufContext.contextByModel"
+    private static let outputKey = "ggufContext.outputByModel"
+    private static let trainedKey = "ggufContext.trainedContextByModel"
+    private static let kvKey = "ggufContext.kvElementsByModel"
+
+    /// Estimated bytes held by the loaded GGUF runtime (0 when none).
+    @Published var residentBytes: Int64 = 0
+
+    private init() {}
+
+    /// Gemma 4 keeps its own small recurrent profile; every other imported
+    /// GGUF uses these settings.
+    static func applies(to repoID: String) -> Bool {
+        let id = repoID.lowercased()
+        return !(id.contains("gemma-4") || id.contains("gemma4"))
+    }
+
+    private static func value(_ key: String, _ repoID: String) -> Int? {
+        UserDefaults.standard.dictionary(forKey: key)?[repoID] as? Int
+    }
+
+    private static func store(_ value: Int, _ key: String, _ repoID: String) {
+        var map = UserDefaults.standard.dictionary(forKey: key) ?? [:]
+        map[repoID] = value
+        UserDefaults.standard.set(map, forKey: key)
+    }
+
+    /// Context the model was trained for, once its header has been read.
+    static func trainedContext(for repoID: String) -> Int? { value(trainedKey, repoID) }
+
+    static func kvElementsPerToken(for repoID: String) -> Int? { value(kvKey, repoID) }
+
+    /// Largest max output for a context: a quarter of it, the same reserve
+    /// LlamaCppVLM.generateText keeps for the reply.
+    static func maximumOutput(forContext context: Int) -> Int { max(256, context / 4) }
+
+    /// Effective limits: saved choice (or 32K / 4096), capped at the trained
+    /// context; output capped at a quarter of the context.
+    static func limits(for repoID: String) -> (context: Int, output: Int) {
+        var context = value(contextKey, repoID) ?? defaultContext
+        if let trained = trainedContext(for: repoID), trained > 0 {
+            context = min(context, trained)
+        }
+        let output = min(value(outputKey, repoID) ?? defaultOutput, maximumOutput(forContext: context))
+        return (context, output)
+    }
+
+    func set(context: Int, output: Int, for repoID: String) {
+        objectWillChange.send()
+        Self.store(context, Self.contextKey, repoID)
+        Self.store(output, Self.outputKey, repoID)
+    }
+
+    /// Caches header facts so limits and the API profile can use them
+    /// without re-reading the file.
+    static func remember(_ shape: GGUFModelShape, for repoID: String) {
+        if shape.trainedContext > 0 { store(shape.trainedContext, trainedKey, repoID) }
+        if shape.kvElementsPerToken > 0 { store(shape.kvElementsPerToken, kvKey, repoID) }
+    }
+}
diff --git a/IOSLocalLLM/Services/LlamaCpp/GGUFLoRAAdapterStore.swift b/IOSLocalLLM/Services/LlamaCpp/GGUFLoRAAdapterStore.swift
new file mode 100644
index 0000000..960bc0b
--- /dev/null
+++ b/IOSLocalLLM/Services/LlamaCpp/GGUFLoRAAdapterStore.swift
@@ -0,0 +1,56 @@
+import Foundation
+import Combine
+
+/// The one llama.cpp LoRA adapter (.gguf) applied to imported GGUF models.
+///
+/// The picked file is copied into Application Support so it outlives the
+/// picker's temporary copy. Only one adapter is kept: choosing a new one
+/// replaces it. Changes take effect the next time a GGUF model loads.
+final class GGUFLoRAAdapterStore: ObservableObject {
+    static let shared = GGUFLoRAAdapterStore()
+
+    private static let fileNameKey = "ggufLoRA.adapterFileName"
+
+    /// File name of the active adapter, or nil when none is set.
+    @Published private(set) var fileName: String?
+
+    private init() {
+        fileName = Self.activeAdapterPath().map { ($0 as NSString).lastPathComponent }
+    }
+
+    static var directory: URL {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("GGUFLoRA", isDirectory: true)
+    }
+
+    /// Absolute path of the active adapter, or nil when none is set or the
+    /// file is gone. Read by the GGUF loader.
+    static func activeAdapterPath() -> String? {
+        guard let name = UserDefaults.standard.string(forKey: fileNameKey) else { return nil }
+        let path = directory.appendingPathComponent(name).path
+        return FileManager.default.fileExists(atPath: path) ? path : nil
+    }
+
+    /// Copies a picked adapter into the app and makes it the active one.
+    func importAdapter(from url: URL) throws {
+        guard url.pathExtension.lowercased() == "gguf" else {
+            throw CocoaError(.fileReadUnsupportedScheme, userInfo: [
+                NSLocalizedDescriptionKey: "Choose a LoRA adapter in GGUF format (.gguf)."
+            ])
+        }
+        let manager = FileManager.default
+        clear()
+        try manager.createDirectory(at: Self.directory, withIntermediateDirectories: true)
+        let destination = Self.directory.appendingPathComponent(url.lastPathComponent)
+        try manager.copyItem(at: url, to: destination)
+        UserDefaults.standard.set(destination.lastPathComponent, forKey: Self.fileNameKey)
+        fileName = destination.lastPathComponent
+    }
+
+    /// Removes the adapter so models load without one.
+    func clear() {
+        try? FileManager.default.removeItem(at: Self.directory)
+        UserDefaults.standard.removeObject(forKey: Self.fileNameKey)
+        fileName = nil
+    }
+}

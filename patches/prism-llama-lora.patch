+/// Context length, max output and prompt batch for the selected imported GGUF
+/// model, saved per model, with a memory estimate (weights, projector, KV
+/// cache, prompt batch) and the Metal offload those settings will get.
+private struct LASGGUFContextCard: View {
+    @ObservedObject private var service = CodingAssistantService.shared
+    @ObservedObject private var store = GGUFContextSettingsStore.shared
+    @State private var shape: GGUFModelShape?
+    @State private var projector: GGUFProjectorInfo?
+
+    /// Text for the memory estimate and for how the model will be offloaded.
+    private struct Estimate {
+        let memory: String
+        let offload: String
+        let exceedsMemory: Bool
+        let reducedOffload: Bool
+    }
+
+    var body: some View {
+        let model = service.activeModel
+        if model.runtime == .llamaCpp, GGUFContextSettingsStore.applies(to: model.repoID) {
+            content(for: model)
+                .task(id: model.repoID) {
+                    shape = await Self.readShape(model)
+                    projector = await Self.readProjector(model)
+                }
+        }
+    }
+
+    private func estimate(context: Int, batch: Int, trained: Int) -> Estimate? {
+        guard let shape else { return nil }
+        let projectorBytes = projector?.bytes ?? 0
+        let needed = GGUFMemoryEstimate.totalBytes(
+            shape, context: context, batch: batch, projectorBytes: projectorBytes
+        )
+        let kv = GGUFMemoryEstimate.kvBytes(elementsPerToken: shape.kvElementsPerToken, context: context)
+        let batchBytes = GGUFMemoryEstimate.batchBytes(embeddingLength: shape.embeddingLength, batch: batch)
+        var memory = "About \(needed.formattedBytes) needed (weights \(shape.fileBytes.formattedBytes)"
+        if let projector {
+            memory += " + projector \(projector.bytes.formattedBytes)"
+        }
+        memory += " + KV cache \(kv.formattedBytes) + prompt batch \(batchBytes.formattedBytes)); "
+        memory += "\(GGUFMemoryEstimate.availableBytes.formattedBytes) available."
+        if trained > 0 {
+            memory += " Trained context: \(trained / 1_024)K."
+        }
+
+        // The same rule the loader applies, so this shows what a load will do.
+        let fits = GGUFMemoryEstimate.fits(
+            shape, context: context, batch: batch, projectorBytes: projectorBytes
+        )
+        let policy = GGUFLoadPolicy.resolve(
+            fileBytes: shape.fileBytes + projectorBytes,
+            pagingEnabled: AppSettings.shared.largeModelLowMemoryEnabled,
+            fullOffloadFits: fits
+        )
+        var offload: String
+        if let projector {
+            offload = "Projector: \(projector.fileName) (\(projector.bytes.formattedBytes)), counted above."
+        } else {
+            offload = "Projector: none."
+        }
+        var reducedOffload = false
+        if policy.storageBacked {
+            offload += " Metal: off because storage-backed paging is on; replies run on the CPU."
+        } else if policy.gpuLayers >= 999 {
+            offload += " Metal: all layers."
+        } else {
+            offload += " Metal: only \(policy.gpuLayers) layers, because these files are over 3 GiB and do not fit in memory with these settings. Replies will be much slower; a smaller projector, context or prompt batch restores full speed."
+            reducedOffload = true
+        }
+        return Estimate(
+            memory: memory,
+            offload: offload,
+            exceedsMemory: GGUFMemoryEstimate.likelyExceeds(
+                shape, context: context, batch: batch, projectorBytes: projectorBytes
+            ),
+            reducedOffload: reducedOffload
+        )
+    }
+
+    private func content(for model: AssistantModel) -> some View {
+        let limits = GGUFContextSettingsStore.limits(for: model.repoID)
+        let batch = GGUFContextSettingsStore.batchSize(for: model.repoID)
+        let trained = shape?.trainedContext
+            ?? GGUFContextSettingsStore.trainedContext(for: model.repoID) ?? 0
+        let contexts = GGUFContextSettingsStore.contextChoices.filter { trained <= 0 || $0 <= trained }
+        let outputs = GGUFContextSettingsStore.outputChoices.filter {
+            $0 <= GGUFContextSettingsStore.maximumOutput(forContext: limits.context)
+        }
+        let details = estimate(context: limits.context, batch: batch, trained: trained)
+        return VStack(alignment: .leading, spacing: LASDesignTokens.row) {
+            LASSectionLabel(title: "CONTEXT", trailing: model.displayName)
+            Text("Context length").font(.subheadline.weight(.semibold))
+            Picker("Context length", selection: Binding(
+                get: { limits.context },
+                set: { newContext in
+                    let output = min(limits.output, GGUFContextSettingsStore.maximumOutput(forContext: newContext))
+                    store.set(context: newContext, output: output, for: model.repoID)
+                }
+            )) {
+                ForEach(contexts, id: \.self) { Text(verbatim: "\($0 / 1_024)K").tag($0) }
+            }
+            .pickerStyle(.segmented)
+            Text("Max output").font(.subheadline.weight(.semibold))
+            Picker("Max output", selection: Binding(
+                get: { limits.output },
+                set: { store.set(context: limits.context, output: $0, for: model.repoID) }
+            )) {
+                ForEach(outputs, id: \.self) { Text(verbatim: "\($0)").tag($0) }
+            }
+            .pickerStyle(.segmented)
+            Text("Prompt batch").font(.subheadline.weight(.semibold))
+            Picker("Prompt batch", selection: Binding(
+                get: { batch },
+                set: { store.set(batch: $0, for: model.repoID) }
+            )) {
+                ForEach(GGUFContextSettingsStore.batchChoices, id: \.self) { Text(verbatim: "\($0)").tag($0) }
+            }
+            .pickerStyle(.segmented)
+            if let details {
+                Text(verbatim: details.memory)
+                    .font(.caption.monospaced())
+                    .foregroundStyle(.secondary)
+                if details.exceedsMemory {
+                    Label("Likely more memory than this iPhone allows; iOS may close the app. Choose a smaller context or prompt batch.", systemImage: "exclamationmark.triangle")
+                        .font(.caption)
+                        .foregroundStyle(.orange)
+                }
+                Text(verbatim: details.offload)
+                    .font(.caption.monospaced())
+                    .foregroundStyle(details.reducedOffload ? Color.orange : Color.secondary)
+            }
+            Text("Bigger contexts and prompt batches use more memory. A larger prompt batch reads the prompt faster; lower it if the app closes while reading one. Context changes apply the next time the model loads; max output and prompt batch apply to the next reply.")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .lasCard(radius: 22, padding: LASDesignTokens.component)
+    }
+
+    private static func readShape(_ model: AssistantModel) async -> GGUFModelShape? {
+        guard let directory = CodingAssistantService.preStagedDirectory(for: model),
+              let file = LocalModelFileValidator.ggufLLM(in: directory) else { return nil }
+        let shape = await Task.detached(priority: .utility) { GGUFModelShape.read(path: file.path) }.value
+        if let shape { GGUFContextSettingsStore.remember(shape, for: model.repoID) }
+        return shape
+    }
+
+    /// The projector the loader will pick for this model, if its folder has one.
+    private static func readProjector(_ model: AssistantModel) async -> GGUFProjectorInfo? {
+        guard let directory = CodingAssistantService.preStagedDirectory(for: model) else { return nil }
+        return await Task.detached(priority: .utility) { GGUFProjectorInfo.find(in: directory) }.value
+    }
+}
+
+/// Picks or clears the llama.cpp LoRA adapter applied to imported GGUF models.
+private struct LASLoRAAdapterCard: View {
+    @ObservedObject private var store = GGUFLoRAAdapterStore.shared
+    let onChoose: () -> Void
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: LASDesignTokens.row) {
+            LASSectionLabel(title: "LORA ADAPTER", trailing: store.fileName == nil ? "OFF" : "SCALE 1.0")
+            Text(verbatim: store.fileName ?? "No adapter")
+                .font(.subheadline.monospaced())
+                .lineLimit(1)
+                .truncationMode(.middle)
+            Text("Applied to imported GGUF models the next time one loads. It must match the base model: the Ternary Bonsai uncensored adapter works with both the PTQ1_0 and PQ2_0 files.")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+            HStack(spacing: LASDesignTokens.tight) {
+                Button(store.fileName == nil ? "Choose adapter file" : "Replace", action: onChoose)
+                    .buttonStyle(LASModelPrimaryActionStyle())
+                if store.fileName != nil {
+                    Button("Clear") { store.clear() }
+                        .buttonStyle(LASModelSecondaryActionStyle(foreground: .red))
+                }
+            }
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .lasCard(radius: 22, padding: LASDesignTokens.component)
+    }
+}
